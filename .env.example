# Required: OpenRouter API key for LLM chat functionality
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (Polygon.io) API key for real market data.
# Leave empty to use the built-in market simulator (recommended).
MASSIVE_API_KEY=

# Optional: set to "true" for deterministic mock LLM responses (testing, no API key needed)
LLM_MOCK=false

# Optional: Google Gemini API key - alternative LLM provider (used if OpenRouter is unset or fails)
GEMINI_API_KEY=

# Optional: which LLM provider to use: auto (default) | openrouter | gemini
LLM_PROVIDER=auto

# Optional: model override for the Gemini provider (default gemini/gemini-2.5-flash)
LLM_MODEL=
